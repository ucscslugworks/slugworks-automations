#!/bin/bash
# Start the Bambu Dashboard on port 5000

cd "$(dirname "$0")"

# Activate venv
source venv/bin/activate 2>/dev/null || echo "No venv found, using system Python"

# Run dashboard
python3 -c "from src.bambu_printers.dashboard import get_dashboard; dashboard = get_dashboard(); dashboard.run(host='0.0.0.0', port=5001, debug=False)"
