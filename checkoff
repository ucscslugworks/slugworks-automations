#!/bin/bash
# Walkthrough check-off tools. See README for the available commands.

cd "$(dirname "$(readlink -f "$0")")"

# start_bambu uses ../venv while the other launchers use ./venv; accept either.
if [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
elif [ -f "../venv/bin/activate" ]; then
    source ../venv/bin/activate
fi

python3 -m src.checkoff "$@"
